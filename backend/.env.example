PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.wt67jkf.mongodb.net/thelawkaksha?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=your_production_secure_jwt_secret_min_64_chars
