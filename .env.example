# ==============================================================================
# The Law Kaksha — Unified Environment Variables Template
# Copy to backend/.env and frontend/.env.local respectively for local deployment.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# --- BACKEND API CONFIGURATION (Express / Render) ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://thelawkaksha.com

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/thelawkaksha?retryWrites=true&w=majority

# JWT Token Secret (Generate a strong 64-character random string)
JWT_SECRET=your_production_secure_jwt_secret_key_minimum_64_characters

# Cloudinary Cloud Storage (For Admin Notes & Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# --- FRONTEND CLIENT CONFIGURATION (Next.js / Vercel) ---
NEXT_PUBLIC_API_URL=https://api.thelawkaksha.com
NEXT_PUBLIC_SITE_URL=https://thelawkaksha.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
